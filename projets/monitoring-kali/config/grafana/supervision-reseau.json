{
  "uid": "supervision-reseau",
  "title": "Supervision du réseau local",
  "tags": ["kali", "reseau", "securite"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "schemaVersion": 39,
  "editable": false,
  "panels": [
    {"type": "row", "title": "État général", "gridPos": {"x": 0, "y": 0, "w": 24, "h": 1}, "id": 1, "collapsed": false, "panels": []},
    {"type": "stat", "title": "Box Internet", "id": 2, "gridPos": {"x": 0, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(probe_success{job=\"ping\", role=\"passerelle\"})"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "INJOIGNABLE", "color": "red"}, "1": {"text": "EN LIGNE", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"type": "stat", "title": "Accès Internet", "id": 3, "gridPos": {"x": 4, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(probe_success{job=\"web\"})"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "COUPÉ", "color": "red"}, "1": {"text": "OK", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"type": "stat", "title": "DNS de la box", "id": 4, "gridPos": {"x": 8, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max(probe_success{job=\"dns\"})"}],
     "options": {"colorMode": "background", "graphMode": "none", "textMode": "value", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "EN PANNE", "color": "red"}, "1": {"text": "OK", "color": "green"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"type": "stat", "title": "Appareils en ligne", "id": 5, "gridPos": {"x": 12, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "reseau_hotes_actifs"}],
     "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}}}},
    {"type": "stat", "title": "Alertes IDS (24 h)", "id": 6, "gridPos": {"x": 16, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "round(sum(increase(suricata_alertes_total[24h])))"}],
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}, {"color": "red", "value": 20}]}}}},
    {"type": "stat", "title": "Nouveaux appareils (24 h)", "id": 7, "gridPos": {"x": 20, "y": 1, "w": 4, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "round(increase(reseau_nouvelles_machines_total[24h]))"}],
     "options": {"colorMode": "background", "graphMode": "none", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 1}]}}}},

    {"type": "row", "title": "Équipements du réseau", "gridPos": {"x": 0, "y": 5, "w": 24, "h": 1}, "id": 10, "collapsed": false, "panels": []},
    {"type": "state-timeline", "title": "Disponibilité des équipements", "id": 11, "gridPos": {"x": 0, "y": 6, "w": 12, "h": 11},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max by (instance, constructeur) (probe_success{job=\"ping\"})", "legendFormat": "{{instance}} {{constructeur}}"}],
     "options": {"showValue": "never", "mergeValues": true, "legend": {"showLegend": false}},
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "hors ligne", "color": "red"}, "1": {"text": "en ligne", "color": "green"}}}]}}},
    {"type": "timeseries", "title": "Temps de réponse (ping)", "id": 12, "gridPos": {"x": 12, "y": 6, "w": 12, "h": 11},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "max by (instance) (probe_icmp_duration_seconds{phase=\"rtt\"})", "legendFormat": "{{instance}}"}],
     "fieldConfig": {"defaults": {"unit": "s", "custom": {"lineWidth": 1, "fillOpacity": 0}}},
     "options": {"legend": {"displayMode": "table", "placement": "right", "calcs": ["mean", "max"]}}},
    {"type": "table", "title": "Appareils détectés", "id": 13, "gridPos": {"x": 0, "y": 17, "w": 24, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "probe_success{job=\"ping\"}", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "job": true, "Value": false}, "renameByName": {"instance": "Adresse IP", "mac": "MAC (préfixe)", "constructeur": "Constructeur", "role": "Rôle", "nom": "Nom", "Value": "En ligne"}}}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "non", "color": "red"}, "1": {"text": "oui", "color": "green"}}}]}}},

    {"type": "row", "title": "Sécurité", "gridPos": {"x": 0, "y": 23, "w": 24, "h": 1}, "id": 20, "collapsed": false, "panels": []},
    {"type": "timeseries", "title": "Alertes Suricata par catégorie", "id": 21, "gridPos": {"x": 0, "y": 24, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (categorie) (increase(suricata_alertes_total[10m]))", "legendFormat": "{{categorie}}"}],
     "fieldConfig": {"defaults": {"custom": {"drawStyle": "bars", "fillOpacity": 60}}}},
    {"type": "timeseries", "title": "Trafic de l'interface surveillée", "id": 22, "gridPos": {"x": 12, "y": 24, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [
       {"refId": "A", "expr": "rate(node_network_receive_bytes_total{device=\"eth1\"}[2m]) * 8", "legendFormat": "reçu"},
       {"refId": "B", "expr": "-rate(node_network_transmit_bytes_total{device=\"eth1\"}[2m]) * 8", "legendFormat": "émis"}],
     "fieldConfig": {"defaults": {"unit": "bps"}}},
    {"type": "table", "title": "Alertes Prometheus en cours", "id": 23, "gridPos": {"x": 0, "y": 32, "w": 24, "h": 6},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "ALERTS{alertstate=\"firing\"}", "format": "table", "instant": true}],
     "transformations": [{"id": "organize", "options": {"excludeByName": {"Time": true, "__name__": true, "Value": true, "alertstate": true}, "renameByName": {"alertname": "Alerte", "severite": "Sévérité", "instance": "Équipement"}}}]},

    {"type": "row", "title": "Sonde Kali", "gridPos": {"x": 0, "y": 38, "w": 24, "h": 1}, "id": 30, "collapsed": false, "panels": []},
    {"type": "gauge", "title": "Processeur", "id": 31, "gridPos": {"x": 0, "y": 39, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "100 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 70}, {"color": "red", "value": 90}]}}}},
    {"type": "gauge", "title": "Mémoire", "id": 32, "gridPos": {"x": 6, "y": 39, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 90}]}}}},
    {"type": "gauge", "title": "Disque /", "id": 33, "gridPos": {"x": 12, "y": 39, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "100 * (1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"})"}],
     "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "max": 100, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 75}, {"color": "red", "value": 85}]}}}},
    {"type": "stat", "title": "Services de supervision actifs", "id": 34, "gridPos": {"x": 18, "y": 39, "w": 6, "h": 5},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(node_systemd_unit_state{state=\"active\", name=~\"(suricata|darkstat|grafana-server|prometheus|prometheus-node-exporter|prometheus-blackbox-exporter|arpwatch@eth1|vnstat|nftables)\\\\.service\"})"}],
     "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
     "fieldConfig": {"defaults": {"unit": "none", "max": 9, "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 9}]}}}}
  ]
}
